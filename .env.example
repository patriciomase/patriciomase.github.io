# Neon Postgres connection string (project: patriciomase-web).
# Copy to .env and fill in, or run `vercel env pull` once the project is linked.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Comma-separated list of email addresses allowed into the admin panel at /a.
# Clerk authenticates; this list authorises. Anyone else who signs in gets a 404.
ADMIN_EMAILS=you@example.com

# Clerk (provisioned by the Vercel Marketplace integration -- `vercel env pull`).
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
